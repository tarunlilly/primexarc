# ARC Evaluator — Environment Configuration
# Copy to .env and fill in real values. Never commit .env itself.
# See app/docs/development.md for setup instructions.

# ── Application ─────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# ── Auth (Azure AD / MSAL) ──────────────────────────────────────────────────
CLIENT_ID=your-client-id-here
TENANT_ID=your-tenant-id-here

# ── History Database (ARC's own Postgres) ───────────────────────────────────
# Leave DB_HOST empty to disable history persistence (app still works).
DB_HOST=
DB_PORT=5432
DB_NAME=your-db-name-here
DB_USER=your-db-user-here
DB_PASSWORD=your-db-password-here
HISTORY_DB_ENABLED=false
HISTORY_DB_SCHEMA=history_assessment
HISTORY_UUID_SOURCE=python

# Role credentials (sourced from AWS secret in prod)
DB_ROLE=
DB_ROLE_PASSWORD=

# ── LLM / Cortex (Phase 3) ─────────────────────────────────────────────────
# When any of these four are empty, the LLM layer is disabled and the
# assessment still completes with rule-based output only.
CLIENT_ID_LLM=your-cortex-client-id-here
TENANT_ID_LLM=your-cortex-tenant-id-here
CLIENT_SECRET_LLM=your-cortex-client-secret-here
MODEL_CONFIG_NAME=your-model-config-name-here

LLM_PROVIDER=cortex
LLM_MODEL=claude-sonnet-4-20250514
CORTEX_BASE_URL=https://gateway.apim-dev.lilly.com/cortex
CORTEX_BASE_URL_FALLBACK=https://gateway-intranet.apim-dev.lilly.com/cortex
HYBRID_ROUTE=human_attestation

# ── Support ─────────────────────────────────────────────────────────────────
SUPPORT_SINK=stub
SUPPORT_EMAIL_TO=ai-readiness@lilly.com
