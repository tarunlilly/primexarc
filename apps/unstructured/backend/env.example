# Environment
ENV=development

# Database Configuration
# Option 1: Full DATABASE_URL (simplest - preferred for production)
# ⚠️ WARNING: Replace all values with secure credentials from secrets manager!
# DATABASE_URL=postgresql+psycopg2://changeme_user:CHANGE_ME_PASSWORD@localhost:5433/changeme_db

# Option 2: Individual components (more flexible - allows database name from secrets)
# ⚠️ WARNING: All values must be set! Get from environment variables/secrets manager!
POSTGRES_USER=changeme_user
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=changeme_db

# Optional: Separate database for Airflow service
# AIRFLOW_DB_NAME=changeme_airflow_db

# CORS - Can be JSON array or comma-separated string
# Examples:
# CORS_ORIGINS=["http://localhost:3000","http://YOUR_DOMAIN:3000"]
# CORS_ORIGINS=http://localhost:3000,http://YOUR_DOMAIN:3000
# ⚠️ WARNING: Replace YOUR_DOMAIN with your actual domain/IP in production!
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication
NEXTAUTH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_FOR_PRODUCTION_USE_ONLY
JWT_ISSUER=https://api.local/auth
JWT_AUDIENCE=primedata-api
API_SESSION_EXCHANGE_ALLOWED_ISS=https://nextauth.local

# OpenAI Configuration (for embedding models)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Storage Configuration
# STORAGE_BACKEND options: "s3" (default) or "gcs"
STORAGE_BACKEND=s3

# AWS S3 Configuration
# For local development with LocalStack:
#   S3_ENDPOINT_URL=http://localhost:4566
#   S3_USE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID=test  (or any value)
#   S3_SECRET_ACCESS_KEY=test  (or any value)
# For production AWS (leave blank to use IAM role):
#   S3_ENDPOINT_URL=  (leave blank)
#   S3_ACCESS_KEY_ID=  (leave blank to use IAM role)
#   S3_SECRET_ACCESS_KEY=  (leave blank to use IAM role)
S3_ENDPOINT_URL=
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

# S3 Connection tuning (optional)
S3_CONNECT_TIMEOUT=10
S3_READ_TIMEOUT=120
S3_MAX_RETRIES=5
S3_MAX_POOL_CONNECTIONS=10

# S3 Bucket Names (optional - defaults to standard names)
# S3_METADATA_BUCKET=primedata-exports  # Bucket for metadata storage
# S3_METADATA_PATH=metadata             # Parent folder/path within bucket for all metadata

# GCS Configuration (optional - for using GCS backend instead of S3)
# Requires STORAGE_BACKEND=gcs and Application Default Credentials
# GCS_PROJECT_ID=your-gcp-project-id

# Elasticsearch Configuration (for vector search)
# For local development, use http://localhost:9200
# No credentials required for local development
ELASTICSEARCH_URL=http://localhost:9200

# Email Configuration (SMTP) - Required for email verification
# See EMAIL_VERIFICATION_SETUP.md for detailed setup instructions
SMTP_ENABLED=false
# Email Domain Validation
# Set to 'false' to disable DNS MX record validation (for MVP/demo environments)
# When disabled, only basic email format (user@domain.tld) is validated
# Set to 'true' for production to verify domain can receive emails (recommended)
EMAIL_DOMAIN_VALIDATION_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=YOUR_EMAIL@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
# Note: For Gmail, use an App Password (not your account password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_FROM_EMAIL=YOUR_EMAIL@gmail.com
FRONTEND_URL=http://localhost:3000